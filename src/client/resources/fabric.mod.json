{
	"schemaVersion": 1,
	"id": "rpg-hud",
	"version": "3.13",

	"name": "RPG-Hud",
	"description": "This mod changes the way the HUD is rendered and adds several new functionalities and styles (mainly RPG-like styles)",
	"authors": [
		"Raelzaryn"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Raelzaryn/RPG-Hud",
		"issues": "https://github.com/Raelzaryn/RPG-Hud/issues"
	},

	"license": "GPL-3.0",

	"environment": "client",
	"entrypoints": {
		"client": [ "net.spellcraftgaming.rpghud.main.ModRPGHud" ],
		"modmenu": [ "net.spellcraftgaming.rpghud.compatibility.ModMenu" ]
	},
	"mixins": [
		"rpg-hud.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"flamingo": "*"
	},
	"custom": {
		"modmenu": {
			"update_checker": true
		}
	}
}
